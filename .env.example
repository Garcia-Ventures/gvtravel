# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically. Do not commit that file.
# Leave a value empty to use the fallback in code.

# Sanity. These public values match the fallbacks in sanity/env.ts.
# The About page reads its article from this project.
NEXT_PUBLIC_SANITY_PROJECT_ID=gxuf40vg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-31

# Formspree form id (the path segment from https://formspree.io/f/<id>).
# Required for inquiry submissions. Empty shows a setup warning in development.
NEXT_PUBLIC_FORMSPREE_ID=

# OpenPanel analytics. Empty uses the same defaults as OpenPanelProvider.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_API_URL=

# Set by Cloudflare Pages on deploy. Leave unset when running locally.
# NEXT_PUBLIC_CF_PAGES_BRANCH=
# NEXT_PUBLIC_CF_PAGES_COMMIT_SHA=
# NEXT_PUBLIC_CF_PAGES_URL=
